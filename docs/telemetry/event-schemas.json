{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healthcore.example/telemetry/event-schemas.json",
  "title": "HealthCore Telemetry Event Schemas",
  "description": "JSON Schema (draft-07) for every HealthCore telemetry event. Every event is composed from eventEnvelope with allOf + $ref. Must stay in sync with telemetry-plan.md.",
  "definitions": {
    "eventEnvelope": {
      "description": "The 8 fields every event carries (telemetry-plan.md, section 5). Only the content of properties changes between events.",
      "type": "object",
      "required": [
        "eventId",
        "timestamp",
        "sessionId",
        "userId",
        "event_type",
        "schemaVersion",
        "requestId",
        "properties"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "UUID v4 generated where the event is created. Used to drop duplicates."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the event happened, ISO 8601 in UTC with a Z suffix."
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "Browser or API session. Scheduled jobs use their job run ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "description": "Pseudonymised staff ID or a service account (e.g. system:expiry-job). Never a name, email or patient identifier."
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)+$",
          "description": "Event name in entity_action snake_case, past tense."
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the event schema, starting at 1.0.0."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "description": "Correlation ID passed from frontend to API to logs (X-Request-Id header)."
        },
        "properties": {
          "type": "object",
          "description": "Event-specific payload. Each event restricts it to its own allowlist."
        }
      },
      "additionalProperties": false
    },
    "inbound_order_created": {
      "description": "Mandatory · Inventory. An inbound order is committed and stock is incremented. Processing: batch.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "inbound_order_created" },
            "properties": {
              "type": "object",
              "required": [
                "clinic_id",
                "country",
                "product_id",
                "product_category",
                "quantity",
                "vendor_id",
                "order_id"
              ],
              "properties": {
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] },
                "product_id": { "type": "string", "minLength": 1 },
                "product_category": { "type": "string", "enum": ["medication", "ppe", "consumable", "equipment"] },
                "quantity": { "type": "integer", "minimum": 1 },
                "vendor_id": { "type": "string", "minLength": 1 },
                "order_id": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "outbound_order_created": {
      "description": "Mandatory · Inventory. An outbound order (consumption by a department) is committed and stock is decremented. Processing: batch.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "outbound_order_created" },
            "properties": {
              "type": "object",
              "required": [
                "clinic_id",
                "country",
                "product_id",
                "product_category",
                "quantity",
                "department",
                "order_id"
              ],
              "properties": {
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] },
                "product_id": { "type": "string", "minLength": 1 },
                "product_category": { "type": "string", "enum": ["medication", "ppe", "consumable", "equipment"] },
                "quantity": { "type": "integer", "minimum": 1 },
                "department": { "type": "string", "enum": ["primary_care", "specialty_care", "chronic_care"] },
                "order_id": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "stock_threshold_triggered": {
      "description": "Mandatory · Inventory. Stock of a product at a clinic crosses below its configured minimum after an outbound order. Fires on the crossing only. Processing: stream.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "stock_threshold_triggered" },
            "properties": {
              "type": "object",
              "required": [
                "clinic_id",
                "country",
                "product_id",
                "product_category",
                "quantity",
                "department",
                "current_stock",
                "min_threshold"
              ],
              "properties": {
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] },
                "product_id": { "type": "string", "minLength": 1 },
                "product_category": { "type": "string", "enum": ["medication", "ppe", "consumable", "equipment"] },
                "quantity": { "type": "integer", "minimum": 1 },
                "department": { "type": "string", "enum": ["primary_care", "specialty_care", "chronic_care"] },
                "current_stock": { "type": "integer", "minimum": 0 },
                "min_threshold": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "direct_stock_edit_rejected": {
      "description": "Mandatory · Inventory. A staff user tries to change stock directly (not through an order) and the backend rejects it. Processing: batch.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "direct_stock_edit_rejected" },
            "properties": {
              "type": "object",
              "required": [
                "clinic_id",
                "country",
                "product_id",
                "product_category",
                "quantity",
                "attempt_source"
              ],
              "properties": {
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] },
                "product_id": { "type": "string", "minLength": 1 },
                "product_category": { "type": "string", "enum": ["medication", "ppe", "consumable", "equipment"] },
                "quantity": { "type": "integer", "not": { "const": 0 }, "description": "Attempted signed stock change: positive adds, negative removes." },
                "attempt_source": { "type": "string", "enum": ["ui", "api"] }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "supply_expiry_flagged": {
      "description": "Mandatory · Inventory. A daily job flags a product in stock entering the 30-day window before expiry. Fires once per product entering the window. userId is system:expiry-job. Processing: batch.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "supply_expiry_flagged" },
            "properties": {
              "type": "object",
              "required": [
                "clinic_id",
                "country",
                "product_id",
                "product_category",
                "quantity",
                "expiry_date",
                "days_to_expiry"
              ],
              "properties": {
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] },
                "product_id": { "type": "string", "minLength": 1 },
                "product_category": { "type": "string", "enum": ["medication", "ppe", "consumable", "equipment"] },
                "quantity": { "type": "integer", "minimum": 1 },
                "expiry_date": { "type": "string", "format": "date" },
                "days_to_expiry": { "type": "integer", "minimum": 0, "maximum": 30 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "order_validation_failed": {
      "description": "Identified · Inventory. The backend rejects a submitted order and nothing is saved. One event per submission with the first error; never carries submitted values. Processing: batch.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "order_validation_failed" },
            "properties": {
              "type": "object",
              "required": [
                "clinic_id",
                "country",
                "order_type",
                "error_code",
                "failed_field"
              ],
              "properties": {
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] },
                "order_type": { "type": "string", "enum": ["inbound", "outbound"] },
                "error_code": { "type": "string", "enum": ["missing_field", "invalid_value", "insufficient_stock", "unknown_product"] },
                "failed_field": { "type": "string", "enum": ["product_id", "quantity", "vendor_id", "department"] },
                "product_id": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "login_failed": {
      "description": "Identified · Authentication. The backend rejects a login attempt. userId is the pseudonymised account ID or anonymous; never carries the typed username, email or password. Processing: stream.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "login_failed" },
            "properties": {
              "type": "object",
              "required": [
                "failure_reason",
                "consecutive_failures",
                "account_known"
              ],
              "properties": {
                "failure_reason": { "type": "string", "enum": ["invalid_credentials", "account_locked", "account_disabled"] },
                "consecutive_failures": { "type": "integer", "minimum": 1 },
                "account_known": { "type": "boolean" },
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "session_expired": {
      "description": "Identified · Authentication. The backend first rejects a request because the session timed out while the user was still working. Processing: batch.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "session_expired" },
            "properties": {
              "type": "object",
              "required": [
                "clinic_id",
                "country",
                "idle_minutes",
                "timeout_minutes",
                "lost_order_submit"
              ],
              "properties": {
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] },
                "idle_minutes": { "type": "integer", "minimum": 0 },
                "timeout_minutes": { "type": "integer", "minimum": 1 },
                "lost_order_submit": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "api_latency_recorded": {
      "description": "Identified · Performance. Emitted by the request middleware for every completed API request. endpoint is the route template, never the real URL. High volume, sampled (section 7). Processing: batch.",
      "allOf": [
        { "$ref": "#/definitions/eventEnvelope" },
        {
          "properties": {
            "event_type": { "const": "api_latency_recorded" },
            "properties": {
              "type": "object",
              "required": [
                "endpoint",
                "http_method",
                "status_code",
                "duration_ms"
              ],
              "properties": {
                "endpoint": { "type": "string", "pattern": "^/[^?#]*$" },
                "http_method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
                "status_code": { "type": "integer", "minimum": 100, "maximum": 599 },
                "duration_ms": { "type": "integer", "minimum": 0 },
                "clinic_id": { "type": "string", "pattern": "^(us|uk)-[a-z]{2,3}-[0-9]{2}$" },
                "country": { "type": "string", "enum": ["US", "UK"] }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}
